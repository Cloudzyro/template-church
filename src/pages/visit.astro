---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { site, services, visit } from "../data/site";
---

<Base title="Plan your visit" description={`Service times, what to expect, kids, parking and accessibility at ${site.name}.`}>
  <PageHero eyebrow="Plan your visit" title="We'd love to meet you" text={visit.intro}>
    <div class="hero-actions">
      <a class="btn btn-gold" href={site.mapsUrl}>Get directions</a>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="when-title">
    <div class="wrap when-grid">
      <div class="card">
        <h2 id="when-title">When we meet</h2>
        <ul class="times">
          {
            services.map((s) => (
              <li>
                <span class="when">{s.day}, {s.time}</span>
                <span class="what">{s.name}</span>
                <span class="note">{s.note}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="card where">
        <h2>Where to find us</h2>
        <address>
          {site.address.street}<br />
          {`${site.address.city}, ${site.address.region} ${site.address.postal}`}
        </address>
        <p>
          Questions before you come? Call <a href={`tel:${site.phone.replace(/[^\d+]/g, "")}`}>{site.phone}</a> or
          <a href="/contact/">send us a note</a>.
        </p>
        <a class="btn btn-primary" href={site.mapsUrl}>Open in maps</a>
      </div>
    </div>
  </section>

  <section class="section expect-section" aria-labelledby="expect-title">
    <div class="wrap">
      <span class="eyebrow">What to expect</span>
      <h2 id="expect-title">Your first Sunday, step by step</h2>
      <ol class="expect">
        {
          visit.expect.map((e, i) => (
            <li>
              <span class="icon-wrap">
                <Icon name={e.icon} />
              </span>
              <div>
                <span class="step">Step {i + 1}</span>
                <h3>{e.title}</h3>
                <p>{e.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap faq-wrap">
      <span class="eyebrow">Good questions</span>
      <h2 id="faq-title">Frequently asked</h2>
      <div class="faq">
        {
          visit.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-actions {
    margin-top: 1.5rem;
  }
  .when-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 20px;
  }
  .times {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .times li {
    display: grid;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }
  .when {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--forest);
  }
  .what {
    font-weight: 700;
  }
  .note {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .where {
    background: var(--sand);
  }
  address {
    font-style: normal;
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
  }
  .expect-section {
    background: var(--paper);
    border-radius: 40px;
  }
  .expect {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .expect li {
    display: flex;
    gap: 1.1rem;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--cream);
    border: 1px solid var(--line);
  }
  .expect p {
    margin: 0;
    color: var(--ink-soft);
  }
  .step {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--clay);
  }
  .icon-wrap {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 18px;
    background: var(--forest);
    color: var(--gold-soft);
  }
  .faq-wrap {
    max-width: 820px;
  }
  .faq {
    display: grid;
    gap: 12px;
    margin-top: 1.5rem;
  }
  details {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 0 22px;
  }
  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 18px 0;
    font-weight: 700;
    font-size: 1.1rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "+";
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--sand);
    color: var(--forest);
    font-size: 1.3rem;
    transition: transform 0.2s ease;
  }
  details[open] summary::after {
    transform: rotate(45deg);
  }
  details p {
    margin: 0 0 18px;
    color: var(--ink-soft);
  }
  @media (max-width: 800px) {
    .when-grid,
    .expect {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .expect li {
      flex-direction: column;
    }
  }
</style>
