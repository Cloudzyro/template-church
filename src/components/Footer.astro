---
import Logo from "./Logo.astro";
import { site, services } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <a class="brand" href="/" aria-label={`${site.name}, home`}>
        <Logo size={44} />
        <span>{site.name}</span>
      </a>
      <p>{site.tagline}.</p>
      <a class="btn btn-gold" href={site.giveUrl}>{site.giveLabel}</a>
    </div>
    <div>
      <h2>Sundays and Wednesdays</h2>
      <ul class="times">
        {services.map((s) => <li><strong>{s.day} {s.time}</strong> {s.name}</li>)}
      </ul>
    </div>
    <div>
      <h2>Visit us</h2>
      <address>
        {site.address.street}<br />
        {`${site.address.city}, ${site.address.region} ${site.address.postal}`}
      </address>
      <p>
        <a href={`tel:${site.phone.replace(/[^\d+]/g, "")}`}>{site.phone}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </div>
  <div class="wrap legal">
    <p>&copy; {year} {site.name}</p>
    <ul>
      {site.social.map((s) => <li><a href={s.url}>{s.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--forest);
    color: #dfe8d9;
    padding-block: 72px 32px;
    border-radius: 40px 40px 0 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: #fff;
    text-decoration: none;
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  .brand :global(svg rect:first-child) {
    fill: #30593d;
  }
  h2 {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--gold);
  }
  .times {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .times strong {
    color: #fff;
    display: block;
  }
  address {
    font-style: normal;
    margin-bottom: 1rem;
  }
  a:not(.btn) {
    color: #fff;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid rgb(255 255 255 / 0.15);
    font-size: 0.9rem;
    color: #c2d0bd;
  }
  .legal p {
    margin: 0;
  }
  .legal ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
