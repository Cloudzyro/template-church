---
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
}
const { eyebrow, title, text } = Astro.props;
---

<section class="page-hero">
  <div class="wrap inner">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    {text && <p class="lede">{text}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: var(--forest);
    color: #e9efe4;
    padding-block: clamp(56px, 9vw, 104px) clamp(48px, 7vw, 80px);
    border-radius: 0 0 28px 28px;
  }
  .inner {
    position: relative;
  }
  h1 {
    color: #fff;
    max-width: 18ch;
  }
  .eyebrow {
    color: var(--gold);
  }
  .lede {
    color: #d5e0cf;
  }
</style>
