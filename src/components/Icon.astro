---

<svg
  class="icon"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={name === "play" ? "currentColor" : "none"}
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name] ?? paths.spark}></path>
</svg>
